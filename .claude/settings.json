{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "marketing-skills@marketingskills": true,
    "content-marketing@claude-code-workflows": true,
    "seo-content-creation@claude-code-workflows": true,
    "social-publishing@claude-code-workflows": true,
    "brand-landingpage@claude-code-workflows": true,
    "ui-design@claude-code-workflows": true,
    "frontend-mobile-development@claude-code-workflows": true,
    "payment-processing@claude-code-workflows": true,
    "business-analytics@claude-code-workflows": true
  },
  "extraKnownMarketplaces": {
    "ui-ux-pro-max-skill": {
      "source": {
        "source": "github",
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill"
      }
    },
    "marketingskills": {
      "source": {
        "source": "github",
        "repo": "coreyhaines31/marketingskills"
      }
    },
    "claude-code-workflows": {
      "source": {
        "source": "github",
        "repo": "wshobson/agents"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/cloud-setup.sh"
          }
        ]
      }
    ]
  }
}
